APP_NAME=Hometic API
APP_ENV=development
# Bắt buộc đổi: chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_ENV=production sẽ từ chối khởi động nếu khoá yếu
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Mức log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hometic_db
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gửi email đặt lại mật khẩu (để trống nếu chưa cần chức năng "Quên mật khẩu")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
